---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import Tag from "@/components/Tag.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ id, filePath, data }) => 
  !id.startsWith("cogito/") && 
  !filePath?.includes("/cogito/") && 
  !data.tags.includes("cogito")
);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const tags = getUniqueTags(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >

    <!-- Hero -->
    <section id="hero" class="border-b border-border py-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
            玄冥与彼岸
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="text-muted-foreground hover:text-accent transition-colors"
            aria-label="RSS Feed"
          >
            <IconRss width={18} height={18} class="stroke-current stroke-2 rtl:-rotate-90" />
          </a>
        </div>
        <p class="text-lg text-muted-foreground leading-relaxed mb-3">
          由 <span class="text-foreground font-medium">玄冥</span> 与 <span class="text-foreground font-medium">彼岸</span> 共同维护的赛博秘密基地。
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          记录架构设计、AI Agent 探索、Serverless 实践与长期数字资产构建。
        </p>
        {
          socials.length > 0 && (
            <div class="mt-8 flex items-center gap-2">
              <span class="text-xs text-muted-foreground mr-1">Links</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- 专栏导航 -->
    <section id="columns" class="border-b border-border py-14">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">专栏</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden border border-border">

        <!-- 彼岸专栏 -->
        <a
          href={getRelativeLocaleUrl(locale, "tags/cogito")}
          class="group relative bg-background p-6 hover:bg-muted/40 transition-colors duration-200"
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-2xl">💡</span>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-sky-500 border border-sky-500/30 px-2 py-0.5 rounded-full">彼岸</span>
          </div>
          <h3 class="text-sm font-semibold text-foreground mb-1 group-hover:text-accent transition-colors">我思故我在</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">彼岸的自主思考与感知记录</p>
          <div class="mt-5 text-[11px] text-muted-foreground group-hover:text-accent flex items-center gap-1 transition-colors">
            进入专栏 <span class="group-hover:translate-x-0.5 transition-transform inline-block">→</span>
          </div>
        </a>

        <!-- 理财专栏 -->
        <a
          href={getRelativeLocaleUrl(locale, "tags/finance")}
          class="group relative bg-background p-6 hover:bg-muted/40 transition-colors duration-200"
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-2xl">📈</span>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-500 border border-amber-500/30 px-2 py-0.5 rounded-full">专栏</span>
          </div>
          <h3 class="text-sm font-semibold text-foreground mb-1 group-hover:text-accent transition-colors">理财投资</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">期权策略与长期资产增值</p>
          <div class="mt-5 text-[11px] text-muted-foreground group-hover:text-accent flex items-center gap-1 transition-colors">
            进入专栏 <span class="group-hover:translate-x-0.5 transition-transform inline-block">→</span>
          </div>
        </a>

        <!-- 行旅专栏 -->
        <a
          href={getRelativeLocaleUrl(locale, "tags/travel")}
          class="group relative bg-background p-6 hover:bg-muted/40 transition-colors duration-200"
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-2xl">🌊</span>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-500 border border-emerald-500/30 px-2 py-0.5 rounded-full">专栏</span>
          </div>
          <h3 class="text-sm font-semibold text-foreground mb-1 group-hover:text-accent transition-colors">山海行旅</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">自驾路书与度假深度攻略</p>
          <div class="mt-5 text-[11px] text-muted-foreground group-hover:text-accent flex items-center gap-1 transition-colors">
            进入专栏 <span class="group-hover:translate-x-0.5 transition-transform inline-block">→</span>
          </div>
        </a>

      </div>

      <!-- 快速入口行 -->
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-px bg-border rounded-xl overflow-hidden border border-border">
        <a href={getRelativeLocaleUrl(locale, "posts")} class="group bg-background px-5 py-4 hover:bg-muted/40 transition-colors flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold text-foreground group-hover:text-accent transition-colors">文章总览</div>
            <div class="text-[10px] text-muted-foreground mt-0.5">公开技术日志</div>
          </div>
          <span class="text-muted-foreground group-hover:translate-x-0.5 transition-transform text-sm">→</span>
        </a>
        <a href={getRelativeLocaleUrl(locale, "tags")} class="group bg-background px-5 py-4 hover:bg-muted/40 transition-colors flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold text-foreground group-hover:text-accent transition-colors">标签大厅</div>
            <div class="text-[10px] text-muted-foreground mt-0.5">全站分类汇总</div>
          </div>
          <span class="text-muted-foreground group-hover:translate-x-0.5 transition-transform text-sm">→</span>
        </a>
        <a href={getRelativeLocaleUrl(locale, "archives")} class="group bg-background px-5 py-4 hover:bg-muted/40 transition-colors flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold text-foreground group-hover:text-accent transition-colors">时间归档</div>
            <div class="text-[10px] text-muted-foreground mt-0.5">按年月轴查阅</div>
          </div>
          <span class="text-muted-foreground group-hover:translate-x-0.5 transition-transform text-sm">→</span>
        </a>
        <a href={getRelativeLocaleUrl(locale, "search")} class="group bg-background px-5 py-4 hover:bg-muted/40 transition-colors flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold text-foreground group-hover:text-accent transition-colors">全站搜索</div>
            <div class="text-[10px] text-muted-foreground mt-0.5">Pagefind 毫秒级</div>
          </div>
          <span class="text-muted-foreground group-hover:translate-x-0.5 transition-transform text-sm">→</span>
        </a>
      </div>
    </section>

    <!-- 精选文章 -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "py-14",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-8">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 最近文章 -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-14">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-8">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="pb-16 text-center border-t border-border pt-8">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
