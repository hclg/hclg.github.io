---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ id, filePath, data }) =>
  !id.startsWith("cogito/") &&
  !filePath?.includes("/cogito/") &&
  !data.tags.includes("cogito")
);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <!-- 全页暗黑网格背景覆盖层 -->
  <div id="d-bg" aria-hidden="true"></div>
  <!-- 光晕 -->
  <div id="d-glow" aria-hidden="true"></div>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="relative z-10 app-layout"
  >

    <!-- Hero -->
    <section id="hero" class="d-hero">
      <div class="d-hero-inner">
        <!-- 左：大标题 -->
        <div class="d-hero-left">
          <h1 class="d-title">
            <span class="d-title-solid">玄冥</span>
            <span class="d-title-grad">与彼岸</span>
          </h1>
          <p class="d-desc">
            记录架构设计、AI Agent 探索、Serverless 实践与长期数字资产构建。<br />
            用技术拓展自由的边界，让计算机替自己工作。
          </p>
          <div class="d-pills">
            <span>AI Agent</span>
            <span>Serverless</span>
            <span>期权投资</span>
            <span>山海行旅</span>
            <span>数字自由</span>
          </div>
        </div>

        <!-- 右：专栏卡片 -->
        <div class="d-hero-right">
          <a href={getRelativeLocaleUrl(locale, "tags/cogito")} class="d-col-card d-col-sky">
            <div class="d-col-icon">💡</div>
            <div class="d-col-info">
              <h3>我思故我在</h3>
              <p>彼岸的自主思考与感知记录</p>
            </div>
            <span class="d-badge d-badge-sky">彼岸</span>
          </a>

          <a href={getRelativeLocaleUrl(locale, "tags/finance")} class="d-col-card d-col-violet">
            <div class="d-col-icon">📈</div>
            <div class="d-col-info">
              <h3>理财投资</h3>
              <p>期权策略与长期资产增值</p>
            </div>
            <span class="d-badge d-badge-violet">专栏</span>
          </a>

          <a href={getRelativeLocaleUrl(locale, "tags/travel")} class="d-col-card d-col-green">
            <div class="d-col-icon">🌊</div>
            <div class="d-col-info">
              <h3>山海行旅</h3>
              <p>自驾路书与度假深度攻略</p>
            </div>
            <span class="d-badge d-badge-green">专栏</span>
          </a>

          <div class="d-col-nav">
            <a href={getRelativeLocaleUrl(locale, "posts")}>文章</a>
            <span class="d-dot">·</span>
            <a href={getRelativeLocaleUrl(locale, "tags")}>标签</a>
            <span class="d-dot">·</span>
            <a href={getRelativeLocaleUrl(locale, "archives")}>归档</a>
            <span class="d-dot">·</span>
            <a href={getRelativeLocaleUrl(locale, "search")}>搜索</a>
            <span style="margin-left:auto;opacity:.3">→</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 精选文章 -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="d-section">
          <div class="d-section-label">{t.home.featured}</div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 最近文章 -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="d-section">
          <div class="d-section-label">{t.home.recentPosts}</div>
          <ul class="d-post-list">
            {recentPosts.slice(0, postsConfig.perIndex).map((data, i) => (
              <li class="d-post-item">
                <span class="d-post-num">0{i + 1}</span>
                <Card variant="h3" {...data} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="d-footer-link">
      <a href={getRelativeLocaleUrl(locale, "posts")} class="d-all-posts">
        {t.home.allPosts} →
      </a>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  /* ── 背景层 ── */
  #d-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #050508;
    background-image:
      linear-gradient(rgba(99,102,241,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,.055) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }
  #d-glow {
    position: fixed;
    top: -120px;
    left: 55%;
    transform: translateX(-30%);
    width: 750px;
    height: 650px;
    background: radial-gradient(ellipse, rgba(139,92,246,.22) 0%, rgba(236,72,153,.09) 40%, transparent 70%);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  /* ── 全局文字颜色覆盖（暗黑背景） ── */
  :global(body) {
    background: #050508 !important;
    color: rgba(255,255,255,.85) !important;
  }
  :global(header), :global(footer) {
    background: transparent !important;
    border-color: rgba(255,255,255,.07) !important;
    color: rgba(255,255,255,.5) !important;
  }
  :global(header a), :global(header button), :global(header svg) {
    color: rgba(255,255,255,.55) !important;
  }
  :global(header a:hover) { color: #a78bfa !important; }

  /* ── Hero ── */
  .d-hero {
    padding: 96px 0 68px;
    position: relative;
  }
  .d-hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .d-hero-inner { grid-template-columns: 1fr; gap: 40px; }
  }

  /* 大标题 */
  .d-title {
    font-size: clamp(72px, 8.5vw, 110px);
    font-weight: 900;
    letter-spacing: -5px;
    line-height: .95;
    margin-bottom: 36px;
    display: flex;
    flex-direction: column;
  }
  .d-title-solid { color: rgba(255,255,255,.92); }
  .d-title-grad {
    background: linear-gradient(135deg, #a78bfa 0%, #f472b6 55%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .d-desc {
    font-size: 14px;
    color: rgba(255,255,255,.38);
    line-height: 1.9;
    margin-bottom: 32px;
    max-width: 520px;
  }
  .d-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .d-pills span {
    font-size: 11px;
    padding: 4px 13px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.38);
    letter-spacing: .3px;
  }

  /* 右侧专栏卡片 */
  .d-hero-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .d-col-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(12px);
    text-decoration: none;
    transition: border-color .2s, background .2s;
  }
  .d-col-card:hover { background: rgba(139,92,246,.08); border-color: rgba(139,92,246,.35); }
  .d-col-icon {
    font-size: 20px;
    width: 42px; height: 42px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 10px;
    flex-shrink: 0;
  }
  .d-col-sky .d-col-icon   { background: rgba(14,165,233,.14); }
  .d-col-violet .d-col-icon { background: rgba(139,92,246,.14); }
  .d-col-green .d-col-icon  { background: rgba(16,185,129,.14); }
  .d-col-info { flex: 1; }
  .d-col-info h3 { font-size: 13px; font-weight: 700; color: rgba(255,255,255,.85); margin-bottom: 3px; }
  .d-col-info p  { font-size: 11px; color: rgba(255,255,255,.3); }

  .d-badge {
    font-size: 9px; font-weight: 700; letter-spacing: 1px;
    padding: 3px 10px; border-radius: 20px; flex-shrink: 0;
  }
  .d-badge-sky    { color: #7dd3fc; background: rgba(14,165,233,.14);  border: 1px solid rgba(14,165,233,.25); }
  .d-badge-violet { color: #c4b5fd; background: rgba(139,92,246,.14);  border: 1px solid rgba(139,92,246,.25); }
  .d-badge-green  { color: #6ee7b7; background: rgba(16,185,129,.14);  border: 1px solid rgba(16,185,129,.25); }

  .d-col-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.02);
  }
  .d-col-nav a { font-size: 12px; color: rgba(255,255,255,.3); text-decoration: none; transition: color .15s; }
  .d-col-nav a:hover { color: #a78bfa; }
  .d-dot { color: rgba(255,255,255,.15); font-size: 12px; }

  /* ── 文章区 ── */
  .d-section { padding: 52px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .d-section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(255,255,255,.22);
    margin-bottom: 24px;
  }

  .d-post-list { list-style: none; padding: 0; margin: 0; }
  .d-post-item {
    display: flex;
    align-items: baseline;
    gap: 20px;
    border-bottom: 1px solid rgba(255,255,255,.05);
  }
  .d-post-item:last-child { border-bottom: none; }
  .d-post-num {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255,255,255,.14);
    flex-shrink: 0;
    width: 22px;
    padding-top: 20px;
  }
  .d-post-item > :global(.card-wrapper),
  .d-post-item > :global(li),
  .d-post-item > :global(article) { flex: 1; }

  /* Card 组件颜色覆盖 */
  :global(#recent-posts .card-wrapper),
  :global(#featured .card-wrapper),
  :global(#recent-posts article),
  :global(#featured article) {
    border-color: rgba(255,255,255,.06) !important;
  }
  :global(#recent-posts a),
  :global(#featured a) {
    color: rgba(255,255,255,.82) !important;
    text-decoration: none !important;
  }
  :global(#recent-posts a:hover),
  :global(#featured a:hover) { color: #c4b5fd !important; }
  :global(#recent-posts h2),
  :global(#recent-posts h3),
  :global(#featured h2),
  :global(#featured h3) {
    color: rgba(255,255,255,.82) !important;
  }
  :global(#recent-posts .post-date),
  :global(#featured .post-date),
  :global(#recent-posts time),
  :global(#featured time) { color: rgba(255,255,255,.25) !important; }
  :global(#recent-posts p),
  :global(#featured p) { color: rgba(255,255,255,.35) !important; }
  :global(#recent-posts .tag),
  :global(#featured .tag) {
    color: rgba(255,255,255,.3) !important;
    border-color: rgba(255,255,255,.1) !important;
  }

  /* ── 底部跳转 ── */
  .d-footer-link {
    padding: 40px 0 60px;
    border-top: 1px solid rgba(255,255,255,.07);
    text-align: center;
  }
  .d-all-posts {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .4px;
    color: #a78bfa;
    text-decoration: none;
    transition: opacity .15s;
  }
  .d-all-posts:hover { opacity: .7; }

  /* Footer 暗色 */
  :global(footer a), :global(footer span), :global(footer p) {
    color: rgba(255,255,255,.22) !important;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
